{% extends "govuk/template.njk" %}

{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}
{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}

{#
  All copy comes from src/data/translations.json through t(lang, key), which build.cjs registers as a global.
  Only pass html=true for the keys translations.json may hold HTML in (see test/translations.test.cjs).
#}

{#- A key's copy in English and Welsh, each in its own part; the script in bodyEnd shows one of them #}
{% macro bilingual(key, html = false) -%}
  <span data-app-lang="en">{% if html %}{{ t("en", key) | safe }}{% else %}{{ t("en", key) }}{% endif %}</span>
  {#- -#}
  <span data-app-lang="cy" hidden>{% if html %}{{ t("cy", key) | safe }}{% else %}{{ t("cy", key) }}{% endif %}</span>
{%- endmacro %}

{#- The contact address as a link, so the link always shows the address it emails #}
{% macro contactLink(lang) -%}
  <a class="govuk-link" href="mailto:{{ t(lang, 'contactEmail') }}">{{ t(lang, "contactEmail") }}</a>
{%- endmacro %}

{% block pageTitle %}{{ t("en", "pageTitle") }}{% endblock %}

{% block headIcons %}
    <link rel="icon" sizes="any" href="{{ faviconDataUri }}" type="image/svg+xml">
{% endblock %}

{% block head %}
    <!-- GOV.UK Frontend {{ govukFrontendVersion }} (dist/govuk/govuk-frontend.min.css) with its fonts and crest inlined:
         this page is served alone, so it cannot load any other file -->
    <style>{{ css | safe }}</style>
    <noscript>
      <style>
        /* The language switch needs JavaScript: without it, show the Welsh message under the English one and drop the switch */
        main div[data-app-lang="cy"] { display: block; margin-top: 30px; padding-top: 30px; border-top: 1px solid var(--govuk-border-colour); }
        .govuk-footer__meta-item--grow > .govuk-visually-hidden, .govuk-footer__inline-list { display: none; }
      </style>
    </noscript>
{% endblock %}

{% block govukSkipLink %}
  {{ govukSkipLink({
    href: "#main-content",
    html: bilingual("skipLink")
  }) }}
{% endblock %}

{% block govukHeader %}
  {# The header defaults to the protocol-relative //gov.uk; link to it over https explicitly #}
  {{ govukHeader({ homepageUrl: "https://www.gov.uk" }) }}
{% endblock %}

{% block govukServiceNavigation %}
  {{ govukServiceNavigation({
    serviceName: bilingual("serviceName"),
    ariaLabel: t("en", "serviceNavigationLabel")
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div data-app-lang="en">
        <h1 class="govuk-heading-xl">{{ t("en", "heading") }}</h1>
        <p class="govuk-body-l">{{ t("en", "subHeading") }}</p>
        <p class="govuk-body">{{ t("en", "useLater") }}</p>
        <p class="govuk-body">{{ t("en", "contact") }} {{ contactLink("en") }}</p>
      </div>
      <div data-app-lang="cy" lang="cy" hidden>
        <h1 class="govuk-heading-xl">{{ t("cy", "heading") }}</h1>
        <p class="govuk-body-l">{{ t("cy", "subHeading") }}</p>
        <p class="govuk-body">{{ t("cy", "useLater") }}</p>
        <p class="govuk-body">{{ t("cy", "contact") }} {{ contactLink("cy") }}</p>
      </div>
    </div>
  </div>
{% endblock %}

{% block govukFooter %}
  {{ govukFooter({
    meta: {
      visuallyHiddenTitle: bilingual("footer.supportLinks"),
      items: [
        {
          href: "?lang=cy",
          text: t("cy", "languageName"),
          attributes: {
            lang: "cy",
            hreflang: "cy",
            "data-app-lang-toggle": "true"
          }
        }
      ]
    },
    contentLicence: {
      html: bilingual("footer.licenceDescription", true)
    },
    copyright: {
      html: bilingual("footer.copyright")
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  {#- The Welsh copy is JSON from t(); translations.json can't hold "<" outside its HTML keys
      (see test/translations.test.cjs), so it can't close this script early. #}
  <script>
    (function () {
      var lang = (window.location.search.match(/[?&]lang=(en|cy)\b/) || [])[1];
      try {
        lang = lang || sessionStorage.getItem('langPref');
        sessionStorage.setItem('langPref', lang === 'cy' ? 'cy' : 'en');
      } catch (e) {}
      if (lang !== 'cy') {
        return;
      }

      document.documentElement.lang = 'cy';
      document.title = {{ t("cy", "pageTitle") | dump | safe }};
      document.querySelector('.govuk-service-navigation').setAttribute('aria-label', {{ t("cy", "serviceNavigationLabel") | dump | safe }});
      var parts = document.querySelectorAll('[data-app-lang]');
      for (var i = 0; i < parts.length; i++) {
        parts[i].hidden = parts[i].getAttribute('data-app-lang') !== 'cy';
      }
      var toggle = document.querySelector('[data-app-lang-toggle]');
      toggle.textContent = {{ t("en", "languageName") | dump | safe }};
      toggle.href = '?lang=en';
      toggle.lang = toggle.hreflang = 'en';
    })();
  </script>
{% endblock %}